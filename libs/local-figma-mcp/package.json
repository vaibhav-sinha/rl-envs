{
  "name": "local-figma-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "local-figma-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:plugin": "node scripts/build-plugin.mjs",
    "build:all": "npm run build && npm run build:plugin",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "ws": "8.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.123.0",
    "@types/node": "^25.7.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.27.3",
    "typescript": "5.7.3",
    "vitest": "4.1.6"
  },
  "description": "Local MCP server proxying Figma MCP tools to a Figma Desktop plugin via WebSocket"
}
