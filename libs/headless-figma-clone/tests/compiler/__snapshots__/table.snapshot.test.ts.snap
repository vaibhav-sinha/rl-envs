// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`table compile > emits stable table markup 1`] = `
"<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <style id="hfc-compiled-css">
#hfc-root{position:relative;width:200px;height:90px;isolation:isolate;}
:root{--hfc-var-VV1:rgba(31,89,235,1);}
.hfc-node-I6{position:absolute;left:0px;top:0px;width:200px;height:90px;box-sizing:border-box;}
    </style>
  </head>
  <body style="margin:0;background:transparent;font-family:ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,'Apple Color Emoji','Segoe UI Emoji';">
    <div id="hfc-root" style="position:relative;width:200px;height:90px;">
      <div class="hfc-node-I6" data-hfc-id="I6" style="z-index:0"><table class="hfc-table" style="width:100%;height:100%;border-collapse:collapse;table-layout:fixed;"><tr><td class="hfc-table-cell" style="width:100px;height:45px;border:1px solid rgba(0,0,0,0.12);vertical-align:middle;padding:4px;box-sizing:border-box;background-color:rgba(255,235,217,1);">A1</td><td class="hfc-table-cell" style="width:100px;height:45px;border:1px solid rgba(0,0,0,0.12);vertical-align:middle;padding:4px;box-sizing:border-box;background-color:transparent;">B1</td></tr><tr><td class="hfc-table-cell" style="width:100px;height:45px;border:1px solid rgba(0,0,0,0.12);vertical-align:middle;padding:4px;box-sizing:border-box;background-color:transparent;">A2</td><td class="hfc-table-cell" style="width:100px;height:45px;border:1px solid rgba(0,0,0,0.12);vertical-align:middle;padding:4px;box-sizing:border-box;background-color:rgba(230,242,255,1);">B2</td></tr></table></div>
    </div>
  </body>
</html>"
`;
