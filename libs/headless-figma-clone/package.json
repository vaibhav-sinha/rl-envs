{
  "name": "headless-figma-clone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "hfc": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/cli.js --transport http",
    "verify:view": "node dist/cli.js verify-view",
    "verify:view:dev": "node verification/viewer/server.mjs",
    "verify:run": "node dist/cli.js verify-run",
    "verify:run:dev": "node verification/scripts/verify-run.mjs",
    "fonts:download": "node scripts/download-inter-fonts.mjs && node scripts/download-barlow-fonts.mjs",
    "fonts:download:barlow": "node scripts/download-barlow-fonts.mjs",
    "fonts:metrics": "node scripts/generate-inter-metrics.mjs && node scripts/generate-barlow-metrics.mjs",
    "pretest": "npx playwright install chromium",
    "test": "vitest run",
    "test:layer-a": "node --test tests/document-model.phase1.test.mjs tests/document-model.phase2.test.mjs tests/document-model.phase3.test.mjs tests/document-model.phase4.test.mjs tests/document-model.phase5.test.mjs tests/document-model.phase7.test.mjs tests/document-model.phase8.test.mjs tests/document-model.phase9.test.mjs",
    "benchmark:i1538": "node --expose-gc scripts/profile-i1538-clone.mjs",
    "benchmark:i1538-512": "node --max-old-space-size=512 --expose-gc scripts/profile-i1538-clone-512.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "path-bool": "^0.0.7",
    "playwright": "1.60.0",
    "ulid": "3.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "fontkit": "^2.0.4",
    "tsx": "4.21.1",
    "typescript": "5.7.3",
    "vitest": "4.1.6"
  },
  "description": "Headless Figma-like document service (Phase 1)"
}
