# syntax=docker/dockerfile:1
# Build from repository root:
#   docker build -f envs/figma-design/shared/environment/Dockerfile.base \
#     -t metaphi/figma-design-base:latest .

FROM node:20-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl git ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

WORKDIR /opt/hfc

COPY libs/headless-figma-clone/package.json libs/headless-figma-clone/package-lock.json ./
RUN npm ci

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npx playwright install chromium
RUN npx playwright install-deps chromium

ARG INSTALL_CURSOR_CLI=false
RUN if [ "$INSTALL_CURSOR_CLI" = "true" ]; then \
      curl https://cursor.com/install -fsS | bash && \
      install -m 0755 /root/.local/bin/cursor-agent /usr/local/bin/cursor-agent; \
    fi
ENV PATH="/usr/local/bin:${PATH}"

COPY libs/headless-figma-clone/ ./
RUN npm run build

ENV HFC_CLI=/opt/hfc/dist/cli.js \
  HFC_HTTP_HOST=127.0.0.1 \
  HFC_HTTP_PORT=3847 \
  HFC_WORKSPACE_DIR=/data/workspace \
  HFC_FONTS_DIR=/opt/hfc/fonts

WORKDIR /app

COPY envs/figma-design/shared/skills/ /skills/

COPY envs/figma-design/shared/environment/entrypoint.sh /usr/local/bin/figma-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/figma-entrypoint.sh \
  && chmod +x /usr/local/bin/figma-entrypoint.sh

# Verifier Python: split layers so requirements changes only rerun pip install.
WORKDIR /opt/figma-verifier
RUN uv python install 3.12
RUN uv venv /opt/figma-verifier/.venv --python 3.12
COPY envs/figma-design/shared/verifier/requirements.txt ./requirements.txt
RUN uv pip install -r /opt/figma-verifier/requirements.txt --python /opt/figma-verifier/.venv
ENV PATH="/opt/figma-verifier/.venv/bin:${PATH}" \
  PYTHONPATH="/opt/figma-verifier"

# Verifier code last: changes here only invalidate this layer (fast rebuilds).
COPY envs/figma-design/shared/verifier/figma_eval /opt/figma-verifier/figma_eval
COPY envs/figma-design/shared/verifier/eval-spec.schema.json /opt/figma-verifier/eval-spec.schema.json

COPY envs/figma-design/designs/ /opt/figma-design/designs/
COPY envs/figma-design/scripts/prepare-task-design.mjs /opt/figma-design/scripts/prepare-task-design.mjs
COPY envs/figma-design/scripts/prune-hfc.mjs /opt/figma-design/scripts/prune-hfc.mjs

WORKDIR /app

EXPOSE 3847
ENTRYPOINT ["/usr/local/bin/figma-entrypoint.sh"]
CMD ["/bin/bash"]
