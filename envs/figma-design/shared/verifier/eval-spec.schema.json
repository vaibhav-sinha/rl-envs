{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HFC Eval Spec",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": { "const": 1 },
    "gates": {
      "type": "object",
      "properties": {
        "require_change": { "type": "boolean" },
        "preserve_ids": { "type": "array", "items": { "type": "string" } },
        "allowed_change_inside_ids": { "type": "array", "items": { "type": "string" } },
        "additions_only": { "type": "boolean" }
      }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "visual": {
      "type": "array",
      "items": { "$ref": "#/$defs/visual" }
    },
    "design_system": {
      "type": "object",
      "properties": {
        "allow_novelty": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "weights": {
      "type": "object",
      "properties": {
        "gates": { "type": "number" },
        "checks": { "type": "number" },
        "design_system": { "type": "number" },
        "visual": { "type": "number" },
        "heuristics": { "type": "number" }
      }
    }
  },
  "$defs": {
    "check": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "type", "contains", "scope", "node_id"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "must_contain_text" },
            "contains": { "type": "string", "minLength": 1 },
            "scope": { "const": "node_id" },
            "node_id": { "type": "string" },
            "case_sensitive": { "type": "boolean" },
            "required": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "contains", "scope"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "must_contain_text" },
            "contains": { "type": "string", "minLength": 1 },
            "scope": { "const": "new_frames" },
            "case_sensitive": { "type": "boolean" },
            "required": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "scope", "node_id"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "must_contain_image" },
            "scope": { "const": "node_id" },
            "node_id": { "type": "string" },
            "image_hash": { "type": "string" },
            "required": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "scope"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "must_contain_image" },
            "scope": { "const": "new_frames" },
            "image_hash": { "type": "string" },
            "required": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "parent_id", "min"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "min_added_under" },
            "parent_id": { "type": "string" },
            "min": { "type": "number", "exclusiveMinimum": 0 },
            "required": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "parent_id", "min"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "min_modified_under" },
            "parent_id": { "type": "string" },
            "min": { "type": "number", "exclusiveMinimum": 0 },
            "required": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "scope_id", "component_id", "min_instances"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "component_instances_under" },
            "scope_id": { "type": "string" },
            "component_id": { "type": "string" },
            "min_instances": { "type": "integer", "minimum": 1 },
            "required": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "parent_id"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "metadata_only_under" },
            "parent_id": { "type": "string" },
            "required": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "node_id", "property", "equals"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "property_on_node" },
            "node_id": { "type": "string" },
            "property": { "type": "string" },
            "equals": {},
            "required": { "type": "boolean" }
          }
        }
      ]
    },
    "visual": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "type", "node_id"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "design_consistency" },
            "node_id": { "type": "string" },
            "surrounding_context_node_id": { "type": "string" },
            "consistency_criteria": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "fit_criteria": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "focus": { "enum": ["largest_added", "added", "all"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "type"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "task_completeness" },
            "node_id": { "type": "string" },
            "evaluation_instructions": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "type", "surrounding_context_node_id"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "before_vs_after" },
            "surrounding_context_node_id": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "type"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "diff" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "type", "reference_asset"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "compare_with_reference" },
            "reference_asset": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
