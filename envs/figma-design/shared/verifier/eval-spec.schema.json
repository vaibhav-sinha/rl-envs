{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HFC Eval Spec",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": { "const": 1 },
    "gates": {
      "type": "object",
      "properties": {
        "require_change": { "type": "boolean" },
        "preserve_ids": { "type": "array", "items": { "type": "string" } },
        "allowed_change_inside_ids": { "type": "array", "items": { "type": "string" } },
        "additions_only": { "type": "boolean" },
        "no_detached_nodes": { "type": "boolean" }
      }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "visual": {
      "type": "array",
      "items": { "$ref": "#/$defs/visual" }
    },
    "metadata_checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/metadata_check" }
    },
    "design_system": {
      "type": "object",
      "properties": {
        "allow_novelty": { "$ref": "#/$defs/allowNovelty" }
      },
      "required": ["allow_novelty"],
      "additionalProperties": false
    },
    "category_importance": {
      "type": "object",
      "description": "Relative importance per scoring category (normalized internally). Gates are not included; they only affect completion_gate.",
      "properties": {
        "commands": { "type": "number", "exclusiveMinimum": 0 },
        "checks": { "type": "number", "exclusiveMinimum": 0 },
        "design_system": { "type": "number", "exclusiveMinimum": 0 },
        "visual": { "type": "number", "exclusiveMinimum": 0 },
        "heuristics": { "type": "number", "exclusiveMinimum": 0 },
        "metadata": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "screenshot": { "$ref": "#/$defs/screenshot" }
  },
  "$defs": {
    "allowNoveltyText": {
      "type": "object",
      "properties": {
        "color": { "type": "boolean" },
        "font_size": { "type": "boolean" },
        "font_family": { "type": "boolean" },
        "font_weight": { "type": "boolean" }
      },
      "required": ["color", "font_size", "font_family", "font_weight"],
      "additionalProperties": false
    },
    "allowNoveltyFrames": {
      "type": "object",
      "properties": {
        "fill": { "type": "boolean" },
        "background": { "type": "boolean" },
        "stroke_color": { "type": "boolean" },
        "stroke_width": { "type": "boolean" },
        "corner_radius": { "type": "boolean" },
        "effects": { "type": "boolean" },
        "item_spacing": { "type": "boolean" },
        "counter_axis_spacing": { "type": "boolean" },
        "padding": { "type": "boolean" },
        "layout_grid": { "type": "boolean" }
      },
      "required": [
        "fill",
        "background",
        "stroke_color",
        "stroke_width",
        "corner_radius",
        "effects",
        "item_spacing",
        "counter_axis_spacing",
        "padding",
        "layout_grid"
      ],
      "additionalProperties": false
    },
    "allowNovelty": {
      "type": "object",
      "properties": {
        "text": { "$ref": "#/$defs/allowNoveltyText" },
        "frames": { "$ref": "#/$defs/allowNoveltyFrames" }
      },
      "required": ["text", "frames"],
      "additionalProperties": false
    },
    "screenshot": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "auto",
            "explicit",
            "largest_added_frame",
            "largest_added_under",
            "largest_changed_frame",
            "minimal_enclosing",
            "all_added_frames"
          ],
          "default": "auto"
        },
        "node_id": { "type": "string" },
        "node_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "under": { "type": "string" },
        "composite": { "type": "boolean", "default": false }
      },
      "required": ["strategy"],
      "allOf": [
        {
          "if": {
            "properties": { "strategy": { "const": "explicit" } },
            "required": ["strategy"]
          },
          "then": {
            "anyOf": [
              { "required": ["node_id"] },
              { "required": ["node_ids"] }
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "subcheck_weight": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Weight for this subcheck when averaging within its category. Default 1.0."
    },
    "check": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "type", "contains", "scope", "node_id"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "must_contain_text" },
            "contains": { "type": "string", "minLength": 1 },
            "scope": { "const": "node_id" },
            "node_id": { "type": "string" },
            "case_sensitive": { "type": "boolean" },
            "required": { "type": "boolean" },
            "weight": { "$ref": "#/$defs/subcheck_weight" }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "contains", "scope"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "must_contain_text" },
            "contains": { "type": "string", "minLength": 1 },
            "scope": { "const": "new_frames" },
            "case_sensitive": { "type": "boolean" },
            "required": { "type": "boolean" },
            "weight": { "$ref": "#/$defs/subcheck_weight" }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "scope", "node_id"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "must_contain_image" },
            "scope": { "const": "node_id" },
            "node_id": { "type": "string" },
            "image_hash": { "type": "string" },
            "required": { "type": "boolean" },
            "weight": { "$ref": "#/$defs/subcheck_weight" }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "scope"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "must_contain_image" },
            "scope": { "const": "new_frames" },
            "image_hash": { "type": "string" },
            "required": { "type": "boolean" },
            "weight": { "$ref": "#/$defs/subcheck_weight" }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "parent_id", "min"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "min_added_under" },
            "parent_id": { "type": "string" },
            "min": { "type": "number", "exclusiveMinimum": 0 },
            "required": { "type": "boolean" },
            "weight": { "$ref": "#/$defs/subcheck_weight" }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "parent_id", "min"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "min_modified_under" },
            "parent_id": { "type": "string" },
            "min": { "type": "number", "exclusiveMinimum": 0 },
            "required": { "type": "boolean" },
            "weight": { "$ref": "#/$defs/subcheck_weight" }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "scope_id", "component_id", "min_instances"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "component_instances_under" },
            "scope_id": { "type": "string" },
            "component_id": { "type": "string" },
            "min_instances": { "type": "integer", "minimum": 1 },
            "required": { "type": "boolean" },
            "weight": { "$ref": "#/$defs/subcheck_weight" }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "parent_id"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "metadata_only_under" },
            "parent_id": { "type": "string" },
            "required": { "type": "boolean" },
            "weight": { "$ref": "#/$defs/subcheck_weight" }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "node_id", "property", "equals"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "property_on_node" },
            "node_id": { "type": "string" },
            "property": { "type": "string" },
            "equals": {},
            "required": { "type": "boolean" },
            "weight": { "$ref": "#/$defs/subcheck_weight" }
          }
        }
      ]
    },
    "visual": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "type"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "good_design" },
            "weight": { "$ref": "#/$defs/subcheck_weight" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "type", "reference_asset", "criteria"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "design_consistency" },
            "reference_asset": { "type": "string", "minLength": 1 },
            "criteria": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1
            },
            "weight": { "$ref": "#/$defs/subcheck_weight" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "type", "node_id", "evaluation_prompt"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "design_fit" },
            "node_id": { "type": "string" },
            "evaluation_prompt": { "type": "string", "minLength": 1 },
            "weight": { "$ref": "#/$defs/subcheck_weight" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "type"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "task_completeness" },
            "node_id": { "type": "string" },
            "evaluation_instructions": { "type": "string", "minLength": 1 },
            "weight": { "$ref": "#/$defs/subcheck_weight" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "type", "reference_asset"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "design_preference" },
            "reference_asset": { "type": "string", "minLength": 1 },
            "weight": { "$ref": "#/$defs/subcheck_weight" }
          },
          "additionalProperties": false
        }
      ]
    },
    "metadata_check": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "type"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "diff" },
            "weight": { "$ref": "#/$defs/subcheck_weight" }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
